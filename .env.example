# ResearchAgent Environment Configuration
# Copy this file to .env and fill in your values

# ============================================================
# LLM Provider Configuration
# ============================================================

# Choose your LLM provider: "openai" or "anthropic"
LLM_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=4096

# Anthropic Configuration (alternative)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ============================================================
# Search Configuration
# ============================================================

# Search engine: "duckduckgo" or "serpapi"
SEARCH_ENGINE=duckduckgo

# SerpAPI (optional, for Google search results)
SERPAPI_KEY=your-serpapi-key-here

# ============================================================
# Application Settings
# ============================================================

# App environment: development, production, testing
APP_ENV=development

# Server configuration
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=sqlite:///./data/research_agent.db

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Maximum concurrent tasks
MAX_CONCURRENT_TASKS=5

# Search results cache TTL in seconds
CACHE_TTL=3600

# File upload settings
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=./data/uploads

# Report output directory
REPORTS_DIR=./data/reports
